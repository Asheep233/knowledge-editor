{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KnowledgeEditor",
  "version": "0.7.3",
  "identifier": "com.knowledgeeditor.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/dist-build"
  },
  "app": {
    "windows": [
      {
        "title": "KnowledgeEditor",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/knowledgeeditor-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
