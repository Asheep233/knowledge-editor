{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UIWS S1 Probe",
  "identifier": "com.astranota.uiws.s1probe",
  "version": "0.0.1",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UIWS S1 Probe",
        "width": 960,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "uiws-probe",
          "windows": ["*"],
          "permissions": ["core:webview:allow-set-webview-zoom", "core:window:allow-set-focus"]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}